{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.invalid/schemas/screenshot-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appBuild",
    "screenshots"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "appBuild": {
      "type": "string",
      "minLength": 1
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "page",
          "state",
          "appearance",
          "locale",
          "width",
          "height",
          "inspector",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
          },
          "page": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "appearance": {
            "enum": [
              "light",
              "dark"
            ]
          },
          "locale": {
            "enum": [
              "en",
              "zh-Hans"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "inspector": {
            "enum": [
              "open",
              "closed",
              "na"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
