{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.invalid/schemas/target-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "approvedTargetCount",
    "pages",
    "reason",
    "requiredBeforeApproval"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "approvedTargetCount": {
      "type": "integer",
      "minimum": 0
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "requiredBeforeApproval": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
