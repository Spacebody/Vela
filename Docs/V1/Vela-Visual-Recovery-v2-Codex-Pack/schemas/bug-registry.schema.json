{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.invalid/schemas/visual-bug-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bugs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "page",
          "severity",
          "title",
          "reproduction",
          "expected",
          "actual",
          "status",
          "evidence",
          "allowedPaths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VR-[A-Z0-9-]+$"
          },
          "page": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "reproduction": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "inProgress",
              "fixedPendingVerification",
              "verified",
              "deferred",
              "notReproducible"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowedPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state": {
            "type": "string"
          },
          "appearance": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "window": {
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "suspectedLayer": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
