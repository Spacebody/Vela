{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.invalid/contracts/v1/hashes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "publicContract",
    "publicContractSHA256",
    "appIntentRegistry",
    "appIntentRegistrySHA256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "algorithm": {
      "const": "SHA-256"
    },
    "canonicalization": {
      "type": "string"
    },
    "publicContract": {
      "const": "public-contract-freeze.json"
    },
    "publicContractSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "appIntentRegistry": {
      "const": "app-intent-registry.json"
    },
    "appIntentRegistrySHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
