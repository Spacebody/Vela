{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.invalid/contracts/v1/app-intent-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "availability",
    "intents",
    "entities",
    "enums",
    "shortcuts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "availability": {
      "enum": [
        "absent",
        "available"
      ]
    },
    "intents": {
      "type": "array"
    },
    "entities": {
      "type": "array"
    },
    "enums": {
      "type": "array"
    },
    "shortcuts": {
      "type": "array"
    }
  }
}
