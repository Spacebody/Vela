{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spacebody/Vela/Hardening/schemas/architecture-freeze.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatorVersion",
    "sources",
    "surfaceDiscovery",
    "product",
    "identifiers",
    "protocols",
    "schemas",
    "trustRoots",
    "bundledComponents",
    "keychainCategories",
    "filesystem",
    "networkEndpointCategories",
    "capabilities",
    "absentSurfaces",
    "releaseSecurity"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "surfaceDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scannedFileCount", "sourcePathListSHA256", "securitySignalSHA256", "urlLiteralSHA256", "filesystemLiteralSHA256"],
      "properties": {
        "scannedFileCount": { "type": "integer", "minimum": 1 },
        "sourcePathListSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "securitySignalSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "urlLiteralSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "filesystemLiteralSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marketingVersion", "build", "minimumMacOS", "architectures"],
      "properties": {
        "marketingVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "build": { "type": "string", "pattern": "^[0-9]+$" },
        "minimumMacOS": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "architectures": { "const": ["arm64"] }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "helper", "helperMachService", "cli", "appGroup", "appIntentIdentifiers"],
      "properties": {
        "application": { "type": "string", "minLength": 1 },
        "helper": { "type": "string", "minLength": 1 },
        "helperMachService": { "type": "string", "minLength": 1 },
        "cli": { "type": ["string", "null"] },
        "appGroup": { "type": ["string", "null"] },
        "appIntentIdentifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["helper", "automation", "cli"],
      "properties": {
        "helper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum", "methodCount", "methods"],
          "properties": {
            "minimum": { "type": "integer", "minimum": 1 },
            "maximum": { "type": "integer", "minimum": 1 },
            "methodCount": { "type": "integer", "minimum": 1 },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
            }
          }
        },
        "automation": { "type": ["object", "null"] },
        "cli": { "type": ["object", "null"] }
      }
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": ["integer", "null"], "minimum": 1 }
    },
    "trustRoots": { "$ref": "#/$defs/objectArray" },
    "bundledComponents": { "$ref": "#/$defs/objectArray" },
    "keychainCategories": { "$ref": "#/$defs/objectArray" },
    "filesystem": { "type": "object" },
    "networkEndpointCategories": { "$ref": "#/$defs/objectArray" },
    "capabilities": { "$ref": "#/$defs/stringSet" },
    "absentSurfaces": { "$ref": "#/$defs/stringSet" },
    "releaseSecurity": { "type": "object" }
  },
  "$defs": {
    "objectArray": {
      "type": "array",
      "items": { "type": "object" }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
