{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spacebody/Vela/Hardening/schemas/beta-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "privacy", "waves", "severity"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteAnalytics", "automaticCrashUpload", "automaticEvidenceUpload", "cohortTracking", "remoteFeatureFlags"],
      "properties": {
        "remoteAnalytics": { "const": false },
        "automaticCrashUpload": { "const": false },
        "automaticEvidenceUpload": { "const": false },
        "cohortTracking": { "const": false },
        "remoteFeatureFlags": { "const": false }
      }
    },
    "waves": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entry", "exit"],
        "properties": {
          "id": { "enum": ["dogfood", "invite", "publicBeta", "stable"] },
          "entry": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "exit": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["S0", "S1", "S2", "S3"],
      "properties": {
        "S0": { "type": "string", "minLength": 1 },
        "S1": { "type": "string", "minLength": 1 },
        "S2": { "type": "string", "minLength": 1 },
        "S3": { "type": "string", "minLength": 1 }
      }
    }
  }
}
