{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spacebody/Vela/Hardening/schemas/fault-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planID", "seed", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planID": { "type": "string", "format": "uuid" },
    "testRunID": { "type": ["string", "null"], "format": "uuid" },
    "seed": { "type": "integer", "minimum": 0 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "point", "occurrence", "effect", "expectedSafeState", "forbiddenOutcomes", "destructive"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "point": {
            "enum": [
              "file.write", "profile.commit.atomicReplace", "keychain.read", "keychain.write", "keychain.delete",
              "subscription.response", "controller.startup", "controller.timeout", "controller.httpResponse",
              "connections.webSocket.disconnect", "process.launch", "process.ownedTermination", "helper.handshake",
              "helper.rpc.timeout", "helper.rpc.interruption", "privileged.start", "tun.waitForController",
              "tun.interfaceReady", "route.health", "systemProxy.verification", "configuration.compile",
              "configuration.validation", "configuration.apply", "appUpdate.journal", "core.install", "core.activate",
              "core.probation.processExit", "scene.commit", "automation.socket", "help.export", "supportBundle.write",
              "testFilesystem.insufficientDisk", "testFilesystem.permissionDenied", "clock.jump", "system.sleepWake"
            ]
          },
          "occurrence": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "delayMilliseconds": { "type": "integer", "minimum": 0, "maximum": 30000 },
          "effect": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "code"],
                "properties": {
                  "kind": { "const": "throw" },
                  "code": { "enum": ["testInjectedFailure", "testInsufficientDisk", "testPermissionDenied", "testKeychainUnavailable", "testControllerUnavailable", "testValidationRejected", "testSignatureRejected", "testJournalFailure"] }
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "milliseconds"],
                "properties": { "kind": { "const": "timeout" }, "milliseconds": { "type": "integer", "minimum": 1, "maximum": 120000 } }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "status"],
                "properties": { "kind": { "const": "httpStatus" }, "status": { "enum": [401, 403, 408, 409, 413, 429, 500, 502, 503, 504] } }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "reason"],
                "properties": { "kind": { "const": "closeWebSocket" }, "reason": { "enum": ["goingAway", "serverRestart", "protocolError", "abnormalClosure"] } }
              },
              { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "insufficientDisk" } } },
              { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "permissionDenied" } } },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "fixture"],
                "properties": { "kind": { "const": "testPath" }, "fixture": { "enum": ["ownedTemporaryFile", "ownedTemporaryDirectory", "ownedReadOnlyFile", "ownedReadOnlyDirectory", "ownedMissingPath"] } }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "seconds"],
                "properties": { "kind": { "const": "clockJump" }, "seconds": { "type": "integer", "minimum": -86400, "maximum": 86400 } }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "phase"],
                "properties": { "kind": { "const": "sleepWake" }, "phase": { "enum": ["sleep", "wake", "sleepThenWake"] } }
              },
              { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "cancellation" } } },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "exitCode"],
                "properties": { "kind": { "const": "ownedProcessExit" }, "exitCode": { "type": "integer", "minimum": 1, "maximum": 255 } }
              }
            ]
          },
          "expectedSafeState": {
            "enum": ["noMutation", "previousBackendHealthy", "previousRevisionActive", "previousKnownGoodCoreActive", "lastKnownGoodConfigurationReadOnly", "safeMode", "tunOff", "systemProxyOff", "rollbackComplete", "supportExportAbsent", "ownedProcessStopped", "retryBounded"]
          },
          "forbiddenOutcomes": {
            "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
            "items": { "enum": ["tunRouteResidue", "systemProxyUnknown", "infiniteRetry", "emptyProfileStore", "activeConfigCorrupt", "factoryCoreDeleted", "rollbackLoop", "partialWrite", "secretExposure", "unauthorizedMutation", "orphanProcess", "staleJournal", "unsafeBackendActive"] }
          },
          "destructive": { "type": "boolean" }
        }
      }
    }
  }
}
