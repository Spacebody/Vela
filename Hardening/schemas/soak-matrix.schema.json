{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spacebody/Vela/Hardening/schemas/soak-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planID", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planID": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "commandID", "repetitions", "destructive", "totalTimeoutSeconds", "perIterationTimeoutSeconds", "cleanupID", "evidence", "requiredMachineCapabilities"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "commandID": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.]{1,95}$" },
          "repetitions": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "destructive": { "type": "boolean" },
          "totalTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
          "perIterationTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "cleanupID": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.]{1,95}$" },
          "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "requiredMachineCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
