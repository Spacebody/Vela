{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spacebody/Vela/Hardening/schemas/evidence-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "localOnly", "automaticUpload", "cloudSync", "retention", "export", "forbiddenFields"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "localOnly": { "const": true },
    "automaticUpload": { "const": false },
    "cloudSync": { "const": false },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumEvents", "maximumDays"],
      "properties": {
        "maximumEvents": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maximumDays": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresExplicitUserAction", "requiresSupportRedactor", "maximumEvents", "maximumBytes"],
      "properties": {
        "requiresExplicitUserAction": { "const": true },
        "requiresSupportRedactor": { "const": true },
        "maximumEvents": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 20971520 }
      }
    },
    "forbiddenFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
