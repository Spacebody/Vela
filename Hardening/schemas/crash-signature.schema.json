{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spacebody/Vela/Hardening/schemas/crash-signature.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "component", "build", "exception", "category", "topApplicationFrames", "signatureSHA256", "containsUserData"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "component": { "enum": ["Vela", "VelaHelper", "vela", "mihomo", "Sparkle", "testHarness"] },
    "build": { "type": "integer", "minimum": 1 },
    "exception": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
    "category": { "enum": ["launch", "stateTransition", "xpc", "configuration", "ui", "update", "core", "migration", "resourceExhaustion", "upstreamMihomo", "unknown"] },
    "topApplicationFrames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_.$<>:+()-]{0,199}$" }
    },
    "signatureSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "containsUserData": { "const": false }
  }
}
