{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spacebody/Vela/Hardening/schemas/fault-plan-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planID", "releaseAllowed", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planID": { "type": "string", "format": "uuid" },
    "releaseAllowed": { "const": false },
    "scenarios": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "preconditions", "cleanupID", "evidence", "timeoutSeconds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "preconditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "cleanupID": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.]{1,95}$" },
          "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
        }
      }
    }
  }
}
