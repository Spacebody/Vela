{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spacebody/Vela/Hardening/schemas/release-readiness.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessedAt", "issues", "conditions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assessedAt": { "type": "string", "format": "date" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^VELA-[A-Z]+-[0-9]{3}$" },
          "severity": { "enum": ["S0", "S1", "S2", "S3"] },
          "status": { "enum": ["open", "fixInProgress", "fixedPendingVerification", "verified", "duplicate", "outOfScope"] },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "active", "evidence", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{1,95}$" },
          "active": { "type": "boolean" },
          "evidence": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
