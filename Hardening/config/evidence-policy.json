{
  "schemaVersion": 1,
  "localOnly": true,
  "automaticUpload": false,
  "cloudSync": false,
  "retention": {
    "maximumEvents": 5000,
    "maximumDays": 30
  },
  "export": {
    "requiresExplicitUserAction": true,
    "requiresSupportRedactor": true,
    "maximumEvents": 500,
    "maximumBytes": 5242880
  },
  "forbiddenFields": [
    "profileName",
    "profileID",
    "sceneName",
    "nodeName",
    "groupName",
    "subscriptionURL",
    "host",
    "destinationIP",
    "sourceIP",
    "SSID",
    "BSSID",
    "processPath",
    "configurationPath",
    "configurationValue",
    "keychainAccount",
    "keychainValue",
    "controllerSecret",
    "rawError",
    "deviceID",
    "userName",
    "serialNumber"
  ]
}
