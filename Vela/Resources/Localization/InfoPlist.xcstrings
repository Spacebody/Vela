    "NSLocationUsageDescription" : {
      "comment" : "Location is requested only for an SSID Scene trigger.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela uses Location permission to read the name of your current Wi-Fi network for Scene automation. It doesn't scan nearby networks or read BSSID information."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 使用定位权限读取当前 Wi-Fi 网络名称，以用于场景自动切换。Vela 不会扫描附近网络，也不会读取 BSSID。"
          }
        }
      }
    }
