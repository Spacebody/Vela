    "settings.privilegedComponent.repairRequired.detail" : {
      "comment" : "Settings-only repair guidance for an unverifiable privileged component.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela could not verify the installed privileged component against this app build. Turn off TUN, then reinstall the component; development builds may also require installing a consistently signed app in Applications."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 无法确认已安装的特权组件与当前应用构建一致。请先关闭 TUN，再重新安装组件；开发构建还可能需要将签名一致的应用安装到“应用程序”文件夹。"
          }
        }
      }
    },
    "settings.privilegedComponent.signingIdentityInvalid.detail" : {
      "comment" : "Settings recovery guidance when the development signing identity cannot establish trust for the privileged component.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela's development signing identity is missing, expired, or not trusted. Create a valid Apple Development certificate in Xcode, rebuild Vela, then reinstall the privileged component."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 的开发签名身份缺失、已过期或不受信任。请在 Xcode 中创建有效的 Apple Development 证书，重新构建 Vela，然后重新安装特权组件。"
          }
        }
      }
    },
    "settings.privilegedComponent.title" : {
      "comment" : "Generic title for privileged-component actions in Settings.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privileged Component"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特权组件"
          }
        }
      }
    },
    "settings.privilegedComponent.uninstall.message" : {
      "comment" : "Confirmation guidance before uninstalling the privileged component.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both options stop and verify the owned runtime before unregistering. Remove Runtime Data is the default and deletes privileged runtime data. Keep Clean Diagnostics Metadata still removes active root configurations, Controller secrets, credentials, and startup logs; it retains only clean, non-secret diagnostic metadata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两种选项都会先停止并验证 Vela 所有的运行时，再取消注册。默认的“移除运行时数据”会删除特权运行时数据；“保留干净的诊断元数据”仍会删除活跃的 root 配置、Controller 密钥、凭据和启动日志，仅保留不含敏感信息的诊断元数据。"
          }
        }
      }
    },
    "settings.privilegedComponent.uninstall.title" : {
      "comment" : "Confirmation title before uninstalling the privileged component.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
