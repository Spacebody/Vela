    "tun.onboarding.install.securityDetail" : {
      "comment" : "Security disclosure in TUN onboarding that explains the privileged component's validation boundary and what Vela never asks the user to do.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The privileged component validates the caller, executable, configuration, paths, and owner lease before starting a privileged runtime. Vela never asks you to paste a terminal command or type an administrator password into the app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特权组件会在启动特权运行时前验证调用方、可执行文件、配置、路径和所有者租约。Vela 绝不会要求你粘贴终端命令或在应用中输入管理员密码。"
          }
        }
      }
    },
