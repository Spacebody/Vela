    "diagnostics.cleanup.confirmation.detail" : {
      "comment" : "Diagnostics user-facing copy. Preserve technical identifiers and format placeholders.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela will authenticate the privileged component, stop only its verified owned instance if needed, clean owned interface/routes/staging, and verify the stopped state twice. The component remains registered; current and previous root configurations are retained until uninstall."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 将验证特权组件，必要时仅停止经验证且归 Vela 所有的实例，清理由 Vela 管理的接口、路由与暂存内容，并两次确认停止状态。组件会继续保持注册；卸载前将保留当前及上一个 Root 配置。"
          }
        }
      }
    },
