    "app.quit.cleanup.message" : {
      "comment" : "Explanation shown before quitting despite unproved proxy runtime cleanup.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela could not confirm that its proxy runtime was fully cleaned up. Cancel quitting to review Diagnostics and retry cleanup, or quit anyway. If System Proxy was active, verify the macOS network proxy settings after quitting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 无法确认代理运行时已完全清理。取消退出可打开“诊断”并重试清理；也可以仍然退出。如果之前启用了系统代理，请在退出后检查 macOS 网络代理设置。"
          }
        }
      }
    },
