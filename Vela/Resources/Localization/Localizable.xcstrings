    "beta.safeMode.description" : {
      "comment" : "User-facing Public Beta hardening and local diagnostics text.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safe Mode uses the Factory Core, keeps network mutations off, disables automatic updates and scenes, and preserves existing stores for recovery."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全模式使用出厂内核、关闭网络变更、停用自动更新与场景，并保留现有存储以便恢复。"
          }
        }
      }
    },
