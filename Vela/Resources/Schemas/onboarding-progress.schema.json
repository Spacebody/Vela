{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.invalid/schemas/onboarding-progress.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "flowVersion",
    "completedStepIDs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "flowVersion": {
      "type": "integer",
      "minimum": 1
    },
    "completedStepIDs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lastStepID": {
      "type": [
        "string",
        "null"
      ]
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "skippedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
