{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.invalid/schemas/help-index.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "contentSchemaVersion",
    "sourceLanguage",
    "supportedLocales",
    "categories",
    "articles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentSchemaVersion": {
      "const": 1
    },
    "sourceLanguage": {
      "const": "en"
    },
    "supportedLocales": {
      "const": [
        "en",
        "zh-Hans"
      ]
    },
    "articles": {
      "type": "array",
      "minItems": 1
    }
  }
}
